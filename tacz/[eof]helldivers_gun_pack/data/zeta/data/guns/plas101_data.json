    "feed": {
      "empty": 2.42,
      "tactical": 2.41
    },
    "cooldown": {
      "empty": 3.01,
      "tactical": 3.00
    }
  },
  "draw_time": 0.75,
  "put_away_time": 0.4,
  "aim_time": 0.12,
  "sprint_time": 0.15,
  "weight": 3.5,
  "fire_mode": [
    "auto",
    "burst"
  ],
    "fire_mode_adjust": {
   
     "burst": {
     "aim_inaccuracy": 0.5,
    "other_inaccuracy": 1
    }
    
  },
"burst_data": {
