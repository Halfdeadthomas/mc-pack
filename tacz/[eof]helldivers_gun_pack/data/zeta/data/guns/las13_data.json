{
   "gunsmithlib_extension": {
    "enable_overheat_feedback": true
  },
  "ammo": "zeta:las_16_ammo",
  "ammo_amount": 2147483647,
 
  "bolt": "open_bolt",
  "rpm": 300,
  "bullet": {
    "life": 0.75,
    "bullet_amount": 6,
    "damage": 60,
    "tracer_count_interval": 0,
    "extra_damage": {
      "armor_ignore": 0.2,
      "head_shot_multiplier": 1.25,
      "damage_adjust": [
        {"distance": 20, "damage": 60},
        {"distance": 50, "damage": 54},
        {"distance": "infinite", "damage": 48}
      ]
    },
    "speed": 1300,
    "gravity": 0,
    "knockback": 0,
    "friction": 0,
    "ignite": false,
    "pierce": 1
  },


"heat":  {
  
    "max": 640,
    // 每次射击（每发子弹）增加的过热计数器值
    "per_shot": 40,
   
    // 停止射击（且超出连射间隔）后开始冷却需要等待的延迟时间，单位秒
    "cooling_delay": 150,
    // 过热惩罚时间，单位秒，过热时射击会额外增加此时间作为冷却延迟
    "over_heat_time": 150
  },




  "reload": {
    "type": "fuel",
    "infinite": false,
    "feed": {
      "empty": 2.2,
      "tactical": 2.8
    },
    "cooldown": {
      "empty": 2.92,
      "tactical": 3.63
    }
  },
  "draw_time": 0.3,
  "put_away_time": 0.43,
  "aim_time": 0.17,
  "sprint_time": 0.18,
  "weight": 5.5,
  "fire_mode": [
    "auto"
  ],
  "recoil": {
    "pitch": [
      {"time": 0, "value": [0.15, 0.15]},
      {"time": 0.3, "value": [0.15, 0.15]},
      {"time": 0.5, "value": [-0.125, -0.125]},
      {"time": 0.65, "value": [0, 0]}
    ],
    "yaw": [
      {"time": 0, "value": [-0.15, 0.15]},
      {"time": 0.3, "value": [-0.15, 0.15]},
      {"time": 0.5, "value": [0, 0]}
    ]
  },
  "inaccuracy": {
    "stand": 3.65,
    "move": 3.7,
    "sneak": 3.65,
    "lie": 3.5,
    "aim": 3.5
  },
  // 近战相关
  "melee": {
    // 枪械距离参数，用来延升近战攻击范围
    // 会与刺刀等配件的距离做加和
    "distance": 1,
    // 使用时的冷却时间
    "cooldown": 0.6,
    // 默认近战数据，会被配件的数据替换掉
    "default": {
      // 动画类型：没有枪托的为 melee_push，有枪托的为 melee_stock
      "animation_type": "melee_stock",
      // 刺刀距离参数，枪械里还有个刺刀攻击距离参数，两者做加和
      "distance": 1,
      // 刺刀范围角度
      "range_angle": 30,
      // 伤害值
      "damage": 5,
      // 击退效果
      "knockback": 0.5,
      // 前摇时长，单位：秒
      "prep": 0.1
    }
  },
 
  "script": "zeta:trident_logic",
  "script_param":{
    "empty_cooldown":3.46,
    "empty_feed":2.35,
    "reload_cooldown":3.79,
    "reload_feed":2.67,
    "cooldown":2,//基础散热速率
    "maxMag1":4,"maxMag2":2,"maxMag3":3,//各级弹匣总热容量倍率
    "coolingMag1":2,"coolingMag2":4,"coolingMag3":3//各级弹匣散热速率倍率
  },
  "builtin_attachments": {
  "scope": "zeta:sight_plasma"
  },
  "allow_attachment_types": [
    "scope",
     "grip",
    "laser",
    "extended_mag"
  ]
 

