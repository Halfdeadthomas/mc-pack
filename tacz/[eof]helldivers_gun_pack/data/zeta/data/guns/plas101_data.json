        {"distance": 24, "damage": 16},
        {"distance": 50, "damage": 12},
        {"distance": "infinite", "damage": 10}
      ]
    },
    "speed": 350,
    "gravity": 0.005,
    "knockback": 0.003,
    "friction": 0.025,
   "ignite": {
    
      // 点燃实体
      "entity": true,
