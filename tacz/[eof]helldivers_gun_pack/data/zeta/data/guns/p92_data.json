      "empty": 2.1,
      "tactical": 1.2
    },
    "cooldown": {
      "empty": 2.3,
      "tactical": 2.2
    }
  },
  "draw_time": 0.35,
  "put_away_time": 0.33,
  "aim_time": 0.2,
  "sprint_time": 0.2,
  "weight": 2,
