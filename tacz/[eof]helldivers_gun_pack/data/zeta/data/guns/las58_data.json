{
   "gunsmithlib_extension": {
    "enable_overheat_feedback": true
  },
  "ammo": "zeta:las_16_ammo",
  "ammo_amount": 2147483647,
 
  "bolt": "open_bolt",
  "rpm": 750,
  "bullet": {
    "life": 0.75,
    "bullet_amount": 1,
    "damage": 32,
    "tracer_count_interval": 0,
    "extra_damage": {
      "armor_ignore": 0.4,
      "head_shot_multiplier": 1.25,
      "damage_adjust": [
        {"distance": 10, "damage": 32},
        {"distance": 50, "damage":18},
        {"distance": "infinite", "damage": 15}
      ]
    },
    "speed": 700,
    "gravity": 0,
    "knockback": 0,
    "friction": 0.015,
    "ignite": false,
    "pierce": 1
  },


"heat":  {
  
    "max": 300,
    // 每次射击（每发子弹）增加的过热计数器值
    "per_shot": 40,
   
    // 停止射击（且超出连射间隔）后开始冷却需要等待的延迟时间，单位秒
    "cooling_delay": 250,
    // 过热惩罚时间，单位秒，过热时射击会额外增加此时间作为冷却延迟
    "over_heat_time": 250
  },

  "reload": {
    "type": "fuel",
    "infinite": false,
    "feed": {
      "empty": 1.32,
      "tactical": 1.31
    },
    "cooldown": {
      "empty": 1.82,
      "tactical": 1.81
    }
  },
  "draw_time": 0.83,
  "put_away_time": 0.3,
  "aim_time": 0.125,
  "sprint_time": 0.08,
  "weight": 1.25,

  "fire_mode": [
    "semi"
  ],
"recoil": {
    "pitch": [
      {"time": 0, "value": [0.35, 0.35]},
      {"time": 0.4, "value": [0.35, 0.35]},
      {"time": 0.65, "value": [-0.225, -0.225]},
      {"time": 0.85, "value": [0.025, 0.025]},
      {"time": 1.1, "value": [0, 0]},
      {"time": 1.2, "value": [0, 0]}
    ],
    "yaw": [
      {"time": 0, "value": [-0.3, 0.3]},
      {"time": 0.5, "value": [0, 0]}
    ]
  },
  "inaccuracy": {
    "stand": 1,
    "move": 4,
    "sneak": 0.5,
    "lie": 0.1,
    "aim": 0.125
  },
  // 近战相关
  "melee": {
    // 枪械距离参数，用来延升近战攻击范围
    // 会与刺刀等配件的距离做加和
    "distance": 1,
    // 使用时的冷却时间
    "cooldown": 0.6,
    // 默认近战数据，会被配件的数据替换掉
    "default": {
      // 动画类型：没有枪托的为 melee_push，有枪托的为 melee_stock
      "animation_type": "melee_push",
      // 刺刀距离参数，枪械里还有个刺刀攻击距离参数，两者做加和
      "distance": 1,
      // 刺刀范围角度
      "range_angle": 30,
      // 伤害值
      "damage": 5,
      // 击退效果
      "knockback": 0.5,
      // 前摇时长，单位：秒
      "prep": 0.1
    }
  },
 
  "script": "zeta:foxatl_heat",
  "script_param":{
    "empty_cooldown":1.82,
    "empty_feed":1.3,
    "reload_cooldown":1.81,
    "reload_feed":1.3,
    "cooldown":2,//基础散热速率 用这个脚本时 一定要把弹药类型设置为fuel
    "maxMag1":2,"maxMag2":1,"maxMag3":1.5,//各级弹匣总热容量倍率 （我写了一级高热容二级高效率三级高性能）
    "coolingMag1":1,"coolingMag2":2,"coolingMag3":1.5//各级弹匣散热速率倍率
  },
  "builtin_attachments": {
    "scope": "zeta:sight_pist"
  },
  "allow_attachment_types": [
    "scope",
    "extended_mag"
  ]
 

}