{
  "script": "zeta:p92_logic",
  "gunsmithlib_extension": {
    "area_effect_cloud_duration": 60,
    "area_effect_cloud_min_size_rate": 0,
     "fire_control": {
      // 能够锁定目标的角范围，单位为角度（°）
      "torque": 2.5,
      "torque_lerp_rate": 0.05,
      "angular_range": 12.5,
      "range_override" : 128
    }
  },
  "heat":  {
    "max": 480,
    // 每次射击（每发子弹）增加的过热计数器值
    "per_shot": 480,
    // 停止射击（且超出连射间隔）后开始冷却需要等待的延迟时间，单位秒
    "cooling_delay": 0,
    "cooling_multiplier": 5,
    // 过热惩罚时间，单位秒，过热时射击会额外增加此时间作为冷却延迟
    "over_heat_time": 0
  },
  "ammo": "zeta:p113_ammo",
  "rpm": 450,
  "bullet": {
    "tracer_count_interval": 0,
    "life": 3.25,
    "bullet_amount": 1,
    "damage": 13,
    "extra_damage": {
      "armor_ignore": 0.40,
      "head_shot_multiplier": 1.75,
      "damage_adjust": [
        {"distance": 15, "damage": 13},
        {"distance": 30, "damage": 13},
        {"distance": 50, "damage": 13},
        {"distance": "infinite", "damage": 13}
      ]
    },
    "speed": 48,
    "gravity": 0,
    "knockback": 0.1,
    "friction": 0,
    "ignite": false,
    "pierce": 1,
    "explosion": {
      "explode": false,
      "damage": 30,
      "radius": 0.75,
      "knockback": true,
      "delay": 1
    }
  },
  "ammo_amount": 13,
  "extended_mag_ammo_amount": [
    15,
